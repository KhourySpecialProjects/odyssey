{
  "kind": "collectionType",
  "collectionName": "mentor_usages",
  "info": {
    "singularName": "mentor-usage",
    "pluralName": "mentor-usages",
    "displayName": "Mentor Usage",
    "description": "One row per Mentor answer: tokens only, never question or answer text (ODY-884)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::authorized-user.authorized-user"
    },
    "kind": {
      "type": "enumeration",
      "enum": ["lesson", "explain", "quiz-hint"],
      "required": true
    },
    "model": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "inputTokens": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "outputTokens": {
      "type": "integer",
      "required": true,
      "min": 0
    }
  }
}
