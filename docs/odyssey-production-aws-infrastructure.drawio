        </mxCell>

        <mxCell id="s1" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="40" as="geometry" /></mxCell>
        <mxCell id="s1b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="1" vertex="1" parent="s1"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="s1d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Public traffic reaches the VPC&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Students reach khouryodyssey.org and data.khouryodyssey.org. The internet gateway admits traffic to the public subnets.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s1"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s2" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="130" as="geometry" /></mxCell>
        <mxCell id="s2b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1" parent="s2"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="s2d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The load balancer terminates TLS&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Port 80 returns a 301 to port 443. Two ACM certificates are attached by SNI, one per hostname.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s2"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s3" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="220" as="geometry" /></mxCell>
        <mxCell id="s3b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1" parent="s3"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="s3d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Default rule routes to the frontend&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Unmatched requests forward to the Next.js target group on port 3000.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s3"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s4" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="310" as="geometry" /></mxCell>
        <mxCell id="s4b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1" parent="s4"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="s4d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Host header rule routes to the backend&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Listener rule priority 100 matches data.khouryodyssey.org and forwards to Strapi on port 1337. Routing is by host, not by path.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s4"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s5" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="400" as="geometry" /></mxCell>
        <mxCell id="s5b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1" parent="s5"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="s5d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The frontend calls Strapi&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Server Components fetch content over the Strapi REST API, authenticated with STRAPI_ACCESS_TOKEN.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s5"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s6" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="490" as="geometry" /></mxCell>
        <mxCell id="s6b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1" parent="s6"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="s6d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Strapi reads and writes Postgres&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A single db.t3.medium instance, not Multi-AZ, private, reachable only from the ECS tasks security group on 5432.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s6"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s7" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="580" as="geometry" /></mxCell>
        <mxCell id="s7b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="7" vertex="1" parent="s7"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="s7d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Media is stored in S3&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Uploads go to odyssey-prod-bucket, which is versioned, encrypted, and public read for CDN delivery.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s7"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s8" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="670" as="geometry" /></mxCell>
        <mxCell id="s8b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="8" vertex="1" parent="s8"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="s8d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Fargate pulls images from ECR&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Both services run the latest tag. GitHub Actions registers a new task definition revision on every push to production, outside Terraform. Applies to both ECS services.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s8"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s9" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="770" as="geometry" /></mxCell>
        <mxCell id="s9b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="9" vertex="1" parent="s9"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="s9d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Secrets are injected at task start&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Every environment variable resolves from odyssey/prod/frontend and odyssey/prod/backend. Nothing sensitive sits in the task definition. Applies to both ECS services.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s9"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s10" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="870" as="geometry" /></mxCell>
        <mxCell id="s10b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="10" vertex="1" parent="s10"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="s10d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Services register in Cloud Map&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A private DNS namespace, odyssey-prod-namespace.local, carries internal service discovery records for both services.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s10"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s11" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="960" as="geometry" /></mxCell>
        <mxCell id="s11b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="11" vertex="1" parent="s11"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="s11d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Private subnets egress through one NAT gateway&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A single NAT gateway in the first public subnet carries outbound traffic for all three private subnets. It is a single point of failure.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s11"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="legend-aux-note" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontStyle=2;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CloudWatch is shown for context only and carries no numbered step. Container Insights is enabled on the cluster, and three log groups retain frontend, backend, and ALB logs for 30 days.&lt;/span&gt;" vertex="1" parent="legend-container">
          <mxGeometry height="60" width="600" x="0" y="1055" as="geometry" />
        </mxCell>

        <mxCell id="legend-lines" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Helvetica;" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;br&gt;Solid arrows carry request traffic.&lt;br&gt;Dashed arrows carry image pulls, secret injection, service registration, and outbound egress.&lt;/span&gt;" vertex="1" parent="legend-container">
          <mxGeometry height="90" width="600" x="0" y="1125" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
