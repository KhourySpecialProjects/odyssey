          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/bradycai/odyssey/.codex/hooks/quality-gate.sh'"
          },
          {
            "type": "command",
            "command": "bash '/Users/bradycai/odyssey/.codex/hooks/suggest-next.sh'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/bradycai/odyssey/.codex/hooks/quality-gate.sh'"
          }
        ]
