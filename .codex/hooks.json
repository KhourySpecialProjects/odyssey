{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/bradycai/odyssey/.codex/hooks/protect-files.sh'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/bradycai/odyssey/.codex/hooks/block-dangerous-commands.sh'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/bradycai/odyssey/.codex/hooks/audit-bash.sh'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
