    {
      "tool": "click",
      "target": "button \"Check Answer\"",
      "input": { "why": "check the answer" }
    },
    {
      "tool": "click",
      "target": "button \"Mark as complete\"",
      "input": { "why": "finish the lesson" }
    },
    {
      "tool": "finish",
      "input": {
        "outcome": "done",
        "summary": "Enrolled in the Big-O droplet and finished its first lesson, answering the quiz."
      }
    }
