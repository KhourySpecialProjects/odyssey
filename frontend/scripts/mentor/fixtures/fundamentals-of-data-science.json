        },
        {
          "id": "a9569b49-dfb5-4049-8672-bb5085f0df96",
          "type": "notebook-code",
          "props": {
            "code": "import pandas as pd\nimport matplotlib.pyplot as plt\ndf = pd.read_csv(\"housing_prices.csv\")",
            "editable": "true",
            "language": "python",
            "testCode": ""
          },
          "children": []
        },
        {
          "id": "081203ce-2b42-48da-ae31-d694e53a218b",
